#!/usr/bin/env bash

set -e

KICHO_BIN_DIR="$(
    cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &&
    pwd
)"

KICHO_ROOT="$(
    cd -- "$KICHO_BIN_DIR/.." &&
    pwd
)"

KICHO_LIB_DIR="$KICHO_ROOT/lib/kicho"

# shellcheck source=/dev/null
source "$KICHO_LIB_DIR/common.sh"
# shellcheck source=/dev/null
source "$KICHO_LIB_DIR/metadata.sh"
# shellcheck source=/dev/null
source "$KICHO_LIB_DIR/path.sh"
# shellcheck source=/dev/null
source "$KICHO_LIB_DIR/project.sh"
# shellcheck source=/dev/null
source "$KICHO_LIB_DIR/source.sh"
# shellcheck source=/dev/null
source "$KICHO_LIB_DIR/diagnostics.sh"
# shellcheck source=/dev/null
source "$KICHO_LIB_DIR/dependencies.sh"
# shellcheck source=/dev/null
source "$KICHO_LIB_DIR/arxiv.sh"
# shellcheck source=/dev/null
source "$KICHO_LIB_DIR/loader.sh"

kicho_load_commands
kicho_project_options "$@"
kicho_dispatch "${KICHO_ARGUMENTS[@]}"
